# ============================================================================
# Step 1-v2 - 纯编译验证（修掉第 3 次构建的 vdso32 工具链错配）
# 生成时间: 2026-10-30
#
# 第 3 次构建（run 41044978354）失败原文：
#   gcc-64/bin/aarch64-linux-android-objcopy: arch/arm64/kernel/vdso32/vdso.so:
#     Not enough room for program headers, try linking with -N
#   make[3]: *** [../arch/arm64/kernel/vdso32/Makefile:129: arch/arm64/kernel/vdso32/vdso.so] Error 1
#
# 根因：
#   defconfig 里有 CONFIG_COMPAT=y + CONFIG_COMPAT_VDSO=y，需要编 32 位 vDSO，
#   必须用 arm32 工具链。但 scripts/toolchain.sh 只导出了
#       GCC_32="CROSS_COMPILE_ARM32=<WORKSPACE>/gcc-32/bin/arm-linux-androideabi-"
#   而 4.14 的 arch/arm64/kernel/vdso32/Makefile 优先读 CROSS_COMPILE_COMPAT，
#   缺失时回落到 64 位的 CROSS_COMPILE，于是用 aarch64 的 objcopy 去处理 32 位
#   ELF，报 "Not enough room for program headers"。
#
# 修复（第 4 次构建仍失败后的修正）：
#   scripts/build.sh 的 make_args() 第 96 行会把 CUSTOM_CMDS 原样拼进 make 命令行，
#   所以在这里补一个 CROSS_COMPILE_COMPAT 即可。
#
# 为什么用相对路径而不是 ${WORKSPACE}：
#   scripts/config.sh 的 cfg_read() 只用 sed 取字面量，不做任何 shell 变量展开，
#   写 $(WORKSPACE) 会被原样当成 make 变量名传下去。
#   而 build.sh 第 134 行是 cd "$KERNEL_DIR" 之后才执行 make，
#   KERNEL_DIR=<WORKSPACE>/android-kernel，GCC32_DIR=<WORKSPACE>/gcc-32，
#   所以相对路径正好是 ../gcc-32/bin/arm-linux-androideabi-
# ============================================================================

# ---- 内核源码 ----
KERNEL_SOURCE=https://github.com/crdroidandroid/android_kernel_xiaomi_sm8150
KERNEL_SOURCE_BRANCH=14.0-raphael

# ---- 配置与产物 ----
# defconfig 在 arch/arm64/configs/ 下，不要加 vendor/ 前缀
KERNEL_CONFIG=raphael_defconfig
# CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y，产物带 appended DTB
KERNEL_IMAGE_NAME=Image.gz-dtb

# ---- 补丁全部关闭（Step 1 只验证编译链路）----
KSU_VARIANT=none
ENABLE_DROIDSPACES=false
ADD_OVERLAYFS_CONFIG=false
ENABLE_PATH_UMOUNT=false
ENABLE_SUSFS=false
ENABLE_STOCKCONFIG=false

# ---- 编译选项 ----
# defconfig 里 CONFIG_LTO=y 且 CONFIG_CC_WERROR=y，4.14 老树配新 clang 必须关掉
DISABLE_LTO=true
DISABLE_CC_WERROR=true

# ---- 工具链（r450784e / 2022 版是 4.14 内核最稳的组合）----
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

# ---- GCC 交叉编译器（4.14 内核必需）----
# 没这个的话 make 命令行完全没有 CROSS_COMPILE，
# 会报 Makefile:541: *** Specify CROSS_COMPILE or add '--target=' option to Makefile.
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

# ---- 修 vdso32 的 32 位工具链错配 ----
# arch/arm64/kernel/vdso32/Makefile 里 vdso.so 的 strip 规则调用 (call if_changed,objcopy)，
# 而 scripts/Makefile.lib 的 cmd_objcopy = $(OBJCOPY) ...，用的是全局 OBJCOPY（即 CROSS_COMPILE + objcopy，64 位）。
# 4.14 这份树没有 OBJCOPY_COMPAT，CROSS_COMPILE_COMPAT 只影响 CC_ARM32/LD_COMPAT。
# 所以直接把 OBJCOPY 指到 32 位 objcopy。
# 32 位 objcopy 处理 64 位目标时只做 strip（-S），能正常工作。
# 相对路径基于 make 的工作目录 <WORKSPACE>/android-kernel
CUSTOM_CMDS=OBJCOPY=../gcc-32/bin/arm-linux-androideabi-objcopy CROSS_COMPILE_COMPAT=../gcc-32/bin/arm-linux-androideabi-

# ============================================================================
# Step 1 成功后，按下面顺序逐项打开，每次只改一组，改完再跑一次：
#
# Step 2 - 加 KernelSU:
#   KSU_VARIANT=sukisu-ultra
#   KSU_REF=builtin
#   KSU_HOOK_MODE=manual
#   ENABLE_PATH_UMOUNT=true
#
# Step 3 - 加 Droidspaces:
#   ENABLE_DROIDSPACES=true
#   ADD_OVERLAYFS_CONFIG=true
#
# Step 4 - 若 SUSFS 补丁打不上，把 DROIDSPACES_BRANCH 改成对应的 tag
#   （默认 v6.6.0；论坛成功案例用的是 Droidspaces 1.0.c3-0061）
# ============================================================================