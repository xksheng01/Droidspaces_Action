# ============================================================================
# Step 1-v3 - 纯编译验证
# 目标：先让 crDroid 14.0-raphael (Linux 4.14.353) 在这套 CI 上完整编过一遍。
# 成功后再逐项打开 KernelSU / Droidspaces。
#
# ---- 构建史（每次只改一处，便于归因）----
# run 41027711411  [10] Apply kernel patches 失败
#   -> KERNEL_CONFIG 路径错（vendor/ 前缀不存在）、IMAGE_NAME 错、KSU 与内置冲突
# run 41044126915  Build kernel 失败
#   -> Makefile:541 *** Specify CROSS_COMPILE
#      原因：USE_LLVM=false 且未开 ENABLE_GCC_ARM64 时，make 命令行完全没有
#      CROSS_COMPILE。修：ENABLE_GCC_ARM64/32=true
# run 41044978354  Build kernel 失败
#   -> arch/arm64/kernel/vdso32/vdso.so: Not enough room for program headers
# run 41056323644  同上（CROSS_COMPILE_COMPAT 没传到子 make）
# run 41058806073  Build kernel 失败
#   -> arch/arm64/kernel/vdso/vdso.so: 127
#      /bin/sh: ../gcc-32/bin/arm-linux-androideabi-objcopy: not found
#      原因：OBJCOPY 被全局改成 32 位，但 64 位 vDSO 也要用它 strip。
#
# ---- vdso32 的真实成因（读代码确认）----
#   vdso/Makefile 第 56-58 行 与 vdso32/Makefile 用的是同一条规则：
#       $(obj)/%.so: OBJCOPYFLAGS := -S
#       $(obj)/%.so: $(obj)/%.so.dbg FORCE
#           $(call if_changed,objcopy)
#   cmd_objcopy（scripts/Makefile.lib）= $(OBJCOPY) ...，全局一个 OBJCOPY，
#   所以不能单边改。
#
#   vdso32/Makefile 第 6-10 行：
#       ifeq ($(cc-name),clang)
#         CC_ARM32 := $(CC) $(CLANG_TARGET_ARM32)
#       else
#         CC_ARM32 := $(CROSS_COMPILE_ARM32)$(cc-name)
#       endif
#       LD_COMPAT ?= $(LD)                      # LLVM 时 → 64 位 aarch64 ld
#       LD_COMPAT ?= $(CROSS_COMPILE_ARM32)ld   # 非 LLVM 时 → arm32 ld
#   构建脚本第 166 行是 `make ... CC="$cc" $args`，CC 在 $args 之后，
#   命令行变量后者胜出，所以 CUSTOM_CMDS 里改 CC 无效；而 USE_LLVM 只在
#   build.sh:100 追加 LLVM=1，同样压不过显式 CC=clang。
#   => cc-name 永远是 clang => vdso32 的 ld 永远是 64 位 => objcopy 报错。
#
# ---- 本版修法：不编 32 位 vDSO ----
#   CONFIG_COMPAT_VDSO 是纯粹的性能优化开关：关掉后 32 位用户态程序不再走
#   vDSO 快路径，改走真正的 syscall，功能完全正常，只有 gettimeofday 之类
#   慢几个纳秒。MIUI 11 用户态几乎没有依赖它的 32 位应用。
#   关掉它，vdso32/Makefile 整个目录不进 make，问题从根上消失。
# ============================================================================

# ---- 内核源码 ----
KERNEL_SOURCE=https://github.com/crdroidandroid/android_kernel_xiaomi_sm8150
KERNEL_SOURCE_BRANCH=14.0-raphael

# ---- 配置与产物 ----
# defconfig 在 arch/arm64/configs/ 下，不要加 vendor/ 前缀
KERNEL_CONFIG=raphael_defconfig
# CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y，产物带 appended DTB
KERNEL_IMAGE_NAME=Image.gz-dtb

# ---- 补丁全部关闭（Step 1 只验证编译链路）----
KSU_VARIANT=none
ENABLE_DROIDSPACES=false
ADD_OVERLAYFS_CONFIG=false
ENABLE_PATH_UMOUNT=false
ENABLE_SUSFS=false
ENABLE_STOCKCONFIG=false

# ---- 编译选项 ----
# defconfig 里 CONFIG_LTO=y 且 CONFIG_CC_WERROR=y，4.14 老树配新 clang 必须关掉
DISABLE_LTO=true
DISABLE_CC_WERROR=true

# ---- 关掉 32 位 vDSO（见文件头说明）----
# 注意：EXTRA_DEFCONFIG 按空格切分，每项必须是 CONFIG_X=y 形式
EXTRA_DEFCONFIG=CONFIG_COMPAT_VDSO=n

# ---- 工具链（r450784e / 2022 版是 4.14 内核最稳的组合）----
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

# ---- GCC 交叉编译器（4.14 内核必需）----
# 没这个的话 make 命令行完全没有 CROSS_COMPILE，
# 会报 Makefile:541: *** Specify CROSS_COMPILE or add '--target=' option to Makefile.
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

# ---- 保险：即使 vdso32 又被编到，也让它的 ld 指向正确的 arm32 ld ----
# 绝对路径的原因：make 会 cd 到子目录执行命令，相对路径在那里解不出来。
# $PWD 在 make 执行时已被 build.sh 设成 <WORKSPACE>/android-kernel。
CUSTOM_CMDS=CROSS_COMPILE_COMPAT=$PWD/gcc-32/bin/arm-linux-androideabi-

# ============================================================================
# Step 1 成功后，按下面顺序逐项打开，每次只改一组，改完再跑一次：
#
# Step 2 - 加 KernelSU:
#   KSU_VARIANT=sukisu-ultra
#   KSU_REF=builtin
#   KSU_HOOK_MODE=manual
#   ENABLE_PATH_UMOUNT=true
#   ENABLE_SUSFS=true
#
# Step 3 - 加 Droidspaces:
#   ENABLE_DROIDSPACES=true
#   ADD_OVERLAYFS_CONFIG=true
#
# Step 4 - 若 SUSFS 补丁打不上，把 DROIDSPACES_BRANCH / SUSFS_BRANCH 调整
# ============================================================================