# ============================================================
# Redmi K20 Pro (raphael) — MIUI 12.5.6 (Android 11) 自编内核
# 目标：KernelSU + Droidspaces（容器支持）
# ============================================================

# ---- 内核源码 ----
KERNEL_SOURCE=https://github.com/crdroidandroid/android_kernel_xiaomi_sm8150
KERNEL_SOURCE_BRANCH=14.0-raphael
KERNEL_CONFIG=raphael_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb

# ---- KernelSU ----
# defconfig 自带 CONFIG_KSU=y，不需要额外安装 KernelSU 源码
KSU_VARIANT=none

# ---- Droidspaces：本轮重点 ----
ENABLE_DROIDSPACES=true
ADD_OVERLAYFS_CONFIG=true

# ---- 其他补丁：本轮全关，先验证 Droidspaces 能过 ----
ENABLE_PATH_UMOUNT=false
ENABLE_SUSFS=false

# ---- 构建稳定性措施 ----
ENABLE_STOCKCONFIG=false
DISABLE_LTO=true
DISABLE_CC_WERROR=true
EXTRA_DEFCONFIG=CONFIG_COMPAT_VDSO=n

# ---- 工具链 ----
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
CUSTOM_CMDS=CROSS_COMPILE_COMPAT=$PWD/gcc-32/bin/arm-linux-androideabi-