# ============================================================================
# Step 1 - 纯编译验证（只验证源码树 + defconfig + clang + 产物名这条链路）
# 生成时间: 2026-10-30
#
# 与上一版（失败的那版）相比只改了 4 处，全部有据可查：
#   1. KERNEL_SOURCE_BRANCH  15.0-raphael -> 14.0-raphael
#      理由: 14.0-raphael 内核 4.14.353，与 Droidspaces 官方支持表里
#            Redmi K20 Pro 那行写的 "4.14.353" 完全一致；15.0-raphael 是 4.14.355
#   2. KERNEL_CONFIG         vendor/raphael_defconfig -> raphael_defconfig
#      理由: 该仓库里根本没有 arch/arm64/configs/vendor/ 目录，
#            实际路径是 arch/arm64/configs/raphael_defconfig
#   3. KERNEL_IMAGE_NAME     Image -> Image.gz-dtb
#      理由: defconfig 里 CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y，
#            产物带 appended DTB，名字是 Image.gz-dtb
#   4. KSU_VARIANT / ENABLE_DROIDSPACES 全部关闭
#      理由: raphael_defconfig 里已经写死 CONFIG_KSU=y 与 CONFIG_KSU_SUSFS=y，
#            这棵树自带 KernelSU+SUSFS；再叠一层 kernelsu-next 必然冲突。
#            上一版失败点就在第 10 步 Apply kernel patches。
# ============================================================================

# ---- 内核源码 ----
KERNEL_SOURCE=https://github.com/crdroidandroid/android_kernel_xiaomi_sm8150
KERNEL_SOURCE_BRANCH=14.0-raphael

# ---- 配置与产物 ----
# 注意：defconfig 在 arch/arm64/configs/ 下，不要再加 vendor/ 前缀
KERNEL_CONFIG=raphael_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb

# ---- 补丁全部关闭（Step 1 只验证编译链路）----
KSU_VARIANT=none
ENABLE_DROIDSPACES=false
ADD_OVERLAYFS_CONFIG=false
ENABLE_PATH_UMOUNT=false
ENABLE_SUSFS=false
ENABLE_STOCKCONFIG=false

# ---- 编译选项 ----
# defconfig 里 CONFIG_LTO=y 且 CONFIG_CC_WERROR=y，
# 4.14 老树配新 clang 必须关掉这两个，否则会因 warning 直接中断
DISABLE_LTO=true
DISABLE_CC_WERROR=true

# ---- 工具链（r450784e / 2022 版是 4.14 内核最稳的组合）----
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

# ---- GCC 交叉编译器（4.14 内核必需，否则 make 直接报错）----
# 报错原文：Makefile:541: *** Specify CROSS_COMPILE or add '--target=' option to Makefile.
# 原因：build.sh 的 make_args() 只在两种情况下给 make 传 CROSS_COMPILE：
#   (a) ENABLE_GCC_ARM64=true  -> 由 toolchain.sh 导出 GCC_64
#   (b) USE_LLVM=true          -> 用兜底的 aarch64-linux-gnu-
# 4.14 这棵老树在 USE_LLVM=false 且没开 GCC 时，make 命令行里完全没有
# CROSS_COMPILE，于是 Makefile:541 直接 die。AOSP GCC 4.9 是 4.14 的标准配置。
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

# ============================================================================
# Step 1 成功后，按下面顺序逐项打开，每次只改一组，改完再跑一次：
#
# Step 2 - 加 KernelSU:
#   KSU_VARIANT=sukisu-ultra
#   KSU_REF=builtin
#   KSU_HOOK_MODE=manual
#   ENABLE_PATH_UMOUNT=true
#
# Step 3 - 加 Droidspaces:
#   ENABLE_DROIDSPACES=true
#   ADD_OVERLAYFS_CONFIG=true
#
# Step 4 - 若 SUSFS 补丁打不上，把 DROIDSPACES_BRANCH 改成对应的 tag
#   （默认 v6.6.0；论坛成功案例用的是 Droidspaces 1.0.c3-0061）
# ============================================================================
